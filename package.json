{
  "name": "beluga-engine",
  "version": "0.1.3",
  "description": "Rudimentary game engine that uses threejs and websockets to create a native multiplayer system for browser game development",
  "main": "./dist/beluga-engine.js",
  "types": "./dist/beluga-engine.d.ts",
  "files": [
    "/dist",
    "/src",
    "/doc",
    "/types"
  ],
  "type": "module",
  "displayName": "Beluga Engine",
  "directories": {
    "doc": "doc",
    "src": "src",
    "dist": "dist",
    "types": "types"
  },
  "scripts": {
    "_clear": "rm -rf ./dist/*",
    "_tsc": "tsc",
    "_make-bundle": "rollup --config",
    "build": "npm run _clear && npm run _tsc && npm run _make-bundle"
  },
  "keywords": [
    "js",
    "ts",
    "game",
    "multiplayer",
    "websockets",
    "beluga-engine",
    "3d"
  ],
  "author": "Iain MacKillop",
  "license": "ISC",
  "repository": {
    "url": "https://github.com/imackill/beluga-engine/tree/master"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "fs": "^0.0.1-security",
    "http": "^0.0.1-security",
    "path": "^0.12.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^22.5.4",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.5.12",
    "rollup": "^4.21.3",
    "rollup-plugin-dts": "^6.1.1",
    "three": "^0.169.0",
    "tslib": "^2.7.0"
  }
}
